# Database
DATABASE_URL=postgresql://postgres:12345@localhost:5432/internship_ats

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin account (created on first startup)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

# File uploads
UPLOAD_DIR=uploads

# Company
COMPANY_NAME=Skynova Tech Solutions

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Brevo SMTP (optional - for sending emails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=skynovatechsolutions@gmail.com
SMTP_FROM_NAME=Skynova Tech Solutions
SMTP_USE_SSL=false

# Evolution API (optional - for WhatsApp)
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=ats-whatsapp
